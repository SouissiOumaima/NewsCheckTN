# Copier ce fichier en .env (jamais commité) et remplir les valeurs.
# --- LLM (Lot D) ---
LLM_PROVIDER=hf              # hf (transformers, ex. Colab GPU) | openai | ollama (API compatible OpenAI)
LLM_MODEL=Qwen/Qwen2.5-7B-Instruct   # verdict Silver (EXP-D-009)
LLM_BASE_URL=                # openai / ollama ; Gemini : https://generativelanguage.googleapis.com/v1beta/openai
LLM_MIN_INTERVAL=4           # pause minimale entre deux appels API (offres gratuites)
LLM_API_KEY=
# --- Retrieval (Lot D) ---
RETRIEVAL_METHOD=bm25         # bm25 | dense | hybrid (dense/hybrid : pip install sentence-transformers)
EMBEDDING_MODEL=intfloat/multilingual-e5-base   # choix EXP-D-003
MIN_DENSE_SIMILARITY=0.4      # seuil d'abstention en dense (à calibrer, EXP-D-003)
INDEX_DIR=rag_llm/index
# --- Modèles (Lot C) ---
NLI_MODEL=MoritzLaurer/mDeBERTa-v3-base-xnli-multilingual-nli-2mil7
CHECKPOINT_DIR=models/checkpoints
# --- API (Lot E) ---
API_HOST=0.0.0.0
API_PORT=8000
