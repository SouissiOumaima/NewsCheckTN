# Copier ce fichier en .env (jamais commité) et remplir les valeurs.
# --- LLM (Lot D) ---
LLM_PROVIDER=none            # none | openai | anthropic | ollama | hf
LLM_MODEL=
LLM_API_KEY=
# --- Retrieval (Lot D) ---
EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
INDEX_DIR=rag_llm/index
# --- Modèles (Lot C) ---
NLI_MODEL=MoritzLaurer/mDeBERTa-v3-base-xnli-multilingual-nli-2mil7
CHECKPOINT_DIR=models/checkpoints
# --- API (Lot E) ---
API_HOST=0.0.0.0
API_PORT=8000
