# Copier ce fichier en .env (jamais commité) et remplir les valeurs.
# --- LLM (Lot D) ---
LLM_PROVIDER=none            # none | openai | anthropic | ollama | hf
LLM_MODEL=
LLM_API_KEY=
# --- Retrieval (Lot D) ---
RETRIEVAL_METHOD=bm25         # bm25 | dense | hybrid (dense/hybrid : pip install sentence-transformers)
EMBEDDING_MODEL=intfloat/multilingual-e5-base   # choix EXP-D-003
MIN_DENSE_SIMILARITY=0.4      # seuil d'abstention en dense (à calibrer, EXP-D-003)
INDEX_DIR=rag_llm/index
# --- Modèles (Lot C) ---
NLI_BACKEND=bronze           # bronze | zero-shot | fine-tuned (Silver, EXP-C-011) | stub
NLI_MODEL=MoritzLaurer/mDeBERTa-v3-base-xnli-multilingual-nli-2mil7   # moteur zero-shot
NLI_FINETUNED_MODEL=          # vide : CHECKPOINT_DIR/nli_mdeberta-ft_v3_lr1e-05_e6_seed42
CHECKPOINT_DIR=models/checkpoints
# --- API (Lot E) ---
API_HOST=0.0.0.0
API_PORT=8000
