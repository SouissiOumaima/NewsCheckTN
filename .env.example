# Copier ce fichier en .env (jamais commité) et remplir les valeurs.
# --- LLM (Lot D) ---
LLM_PROVIDER=ollama          # modèle officiel local ; hf et openai restent disponibles
LLM_MODEL=hf.co/tiiuae/Falcon-H1-3B-Instruct-GGUF:Q4_K_M
LLM_BASE_URL=http://localhost:11434/v1
LLM_RESPONSE_FORMAT=json     # EXP-D-015 ; nécessite la PR #33 (lot-d-falcon)
LLM_UNCERTAINTY_MODE=nli     # nli (EXP-D-021, indicateur non calibré) | fixe (0.4, avant EXP-D-021)
LLM_MIN_INTERVAL=0
LLM_API_KEY=ollama           # valeur locale conventionnelle, pas un jeton d'authentification
# --- Retrieval (Lot D) ---
RETRIEVAL_METHOD=bm25         # bm25 | dense | hybrid (dense/hybrid : pip install sentence-transformers)
RERANKER=off                 # off (défaut) | bge : re-ranker EXP-D-020, adopté pour la recherche mais non activé (arabizi)
EMBEDDING_MODEL=intfloat/multilingual-e5-base   # choix EXP-D-003
MIN_DENSE_SIMILARITY=0.4      # seuil d'abstention en dense (à calibrer, EXP-D-003)
INDEX_DIR=rag_llm/index
# --- Modèles (Lot C) ---
NLI_BACKEND=bronze           # bronze | zero-shot | fine-tuned (Silver, EXP-C-011) | stub
NLI_MODEL=MoritzLaurer/mDeBERTa-v3-base-xnli-multilingual-nli-2mil7   # moteur zero-shot
NLI_FINETUNED_MODEL=          # vide : CHECKPOINT_DIR/nli_mdeberta-ft_v3_lr1e-05_e6_seed42
CHECKPOINT_DIR=models/checkpoints
# --- API (Lot E) ---
API_HOST=0.0.0.0
API_PORT=8000

# --- Intégration Silver (Lot E) ---
VERDICT_BACKEND=gabarit      # gabarit (défaut sans LLM) | llm
LLM_ALLOW_EXTERNAL=0         # 1 seulement après accord explicite de l'équipe
# Démo locale Falcon : VERDICT_BACKEND=llm, Ollama et modèle installés sur le même PC.
# Aya EXP-D-010 reste historique ; le score Falcon EXP-D-015 est optimiste (second passage).
# Les runs Falcon EXP-D-014/015 utilisent NLI_BACKEND=bronze.
# Gold confirmé par le Lot D : NLI_BACKEND=fine-tuned (EXP-D-018), configuration différente.
# Retrieval/NLI sont indépendants : RETRIEVAL_METHOD=hybrid, NLI_BACKEND=fine-tuned.
